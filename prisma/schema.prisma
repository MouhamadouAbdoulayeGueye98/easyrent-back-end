generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String?
  role          Role     @default(LOCATAIRE) // Utilisation de l'enum Role
  phone         String?
  city          String?
  publisherType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties Property[]
  favorites  Favorite[]

  ownerConversations  Conversation[] @relation("OwnerConversations")
  tenantConversations Conversation[] @relation("TenantConversations")
  messages            Message[]
}

enum Role {
  LOCATAIRE
  PROPRIETAIRE
  ADMIN
}

model Property {
  id          String   @id @default(uuid())
  title       String
  description String

  // Localisation
  address     String
  city        String
  quartier    String?
  latitude    Float?
  longitude   Float?

  // Type et caractéristiques
  type        PropertyType
  price       Float
  surface     Float?
  rooms       Int?

  // Filtres avancés (cahier des charges section 6.4)
  furnished       Boolean @default(false)
  waterIncluded   Boolean @default(false)
  electricityIncluded Boolean @default(false)
  wifiAvailable   Boolean @default(false)
  parking         Boolean @default(false)
  airConditioning Boolean @default(false)
  petsAllowed     Boolean @default(false)

  // Statut
  status      PropertyStatus @default(EN_ATTENTE)
  verified    Boolean        @default(false)
  available   Boolean        @default(true)

  // Relations
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  photos      Photo[]
  favorites   Favorite[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
}

model Photo {
  id         String   @id @default(uuid())
  url        String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

enum PropertyType {
  CHAMBRE
  STUDIO
  COLOCATION
  APPARTEMENT
}

enum PropertyStatus {
  EN_ATTENTE
  VALIDEE
  SUSPENDUE
  REFUSEE
}

model Conversation {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  owner      User     @relation("OwnerConversations", fields: [ownerId], references: [id])
  ownerId    String
  tenant     User     @relation("TenantConversations", fields: [tenantId], references: [id])
  tenantId   String
  messages   Message[]
  createdAt  DateTime @default(now())

  @@unique([propertyId, tenantId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
}