DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?schema=public&connection_limit=10&pool_timeout=20"

# BREVO
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM=YOUR_EMAIL

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# FRONTEND
#
FRONTEND_URL=http://localhost:8081
# Pour production (Vercel): 
#FRONTEND_URL=https://easyrent-web-admin.vercel.app

# JWT
JWT_SECRET=YOUR_JWT_SECRET

# ADMIN ACCOUNT (Pour la création de l'administrateur via seed)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_password_here
